pipeline {
    agent {label "dev"}

    stages {
        stage('CODE CLONE') {
            steps {
                git url: "https://github.com/NAVIMAHAL/two-tier-flask-app", branch: "demo"
            }
        }
    
        stage('CODE BUILD'){
            steps{
                sh "docker build -t two-tier-flask-app ."
            }
        }    
        
        stage("CODE TEST"){
            steps{
                echo "CODE WILL BE TESTED BY DEVELOPER..."
            }
        }
        
        stage("PUSH TO DOCKER HUB"){
            steps{
                withCredentials([usernamePassword(
                    credentialsId: "dockerHubCreds",
                    usernameVariable: "dockerHubUser",
                    passwordVariable: "dockerHubPass",
                    )]){
                        
                        sh "docker login -u ${env.dockerHubUser} -p ${env.dockerHubPass}"
                        sh "docker image tag two-tier-flask-app ${env.dockerHubUser}/two-tier-flask-app"
                        sh "docker push ${env.dockerHubUser}/two-tier-flask-app"
                    }
            }
        }
        
        stage("Code Deployment"){
            steps{
                sh "docker compose up -d --build"
            }
        }
        
    }
    
    post{
        
        success{
            script{
                emailext from: "navkirat94@gmail.com",
                to: "navkirat94@gmail.com",
                subject: "BUILD SUCCESS",
                body: "DEMO CICD APPLICAtION HAS BEEN SUCCESSFULLY DEPLOYED"
            }    
        }
        
        failure{
            script{
                emailext from: "navkirat94@gmail.com",
                to: "navkirat94@gmail.com",
                subject: "BUILD FAILURE",
                body: "DEMO CICD APPLICATION HAS BEEN FAILED INCORRECTLY"
                
            }
            
        }
    }
    
}
